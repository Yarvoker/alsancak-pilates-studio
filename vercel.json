{
  "ignoreCommand": "bash -c 'git log -1 --pretty=%s | grep -q \"^drop-portrait-part\"'",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "alsancak-pilates-studio.vercel.app" }],
      "destination": "https://www.alsancakpilates.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "alsancak-pilates-studio.vercel.app" }],
      "destination": "https://www.alsancakpilates.com/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/hesabim",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/hesabim/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/hesabim", "destination": "/index.html" },
    { "source": "/gizlilik", "destination": "/index.html" },
    { "source": "/paket-kosullari", "destination": "/index.html" },
    { "source": "/iptal-iade", "destination": "/index.html" },
    { "source": "/mesafeli-satis", "destination": "/index.html" },
    { "source": "/cerez", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
